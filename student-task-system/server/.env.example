# Copy this file to .env and fill in the values. NEVER commit .env.
PORT=3000

# From Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy "project_id", "client_email" and "private_key" from the downloaded JSON file.
FIREBASE_PROJECT_ID=lab7-223593
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lab7-223593.iam.gserviceaccount.com
# Keep the quotes and the \n characters exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated list of frontend addresses allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: rate limit (default 100 requests per 15 minutes per IP).
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Set to 1 on Render (it runs behind one proxy).
# TRUST_PROXY=1
